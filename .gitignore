# -------------------------
# Python / Django (Backend)
# -------------------------

# Virtual Environments
venv/
env/
.venv/
.virtual_envs/

# Byte-compiled files
__pycache__/
*.py[cod]

# Database and secrets
db.sqlite3
*.log
.env
*.env

# Static/Media files generated on deployment (often ignored)
# If you run collectstatic into this folder, IGNORE it!
/static_root/
/media/

# IDE specific files (e.g., PyCharm)
.idea/
.vscode/

# -------------------------
# Node / React (Frontend)
# -------------------------

# Dependency directory
/frontend/node_modules

# Build / Distribution output
# This folder is usually created when you run `npm run build`
/frontend/build
/frontend/dist

# Logs and cache
npm-debug.log*
yarn-debug.log*
.npm
.yarn/
.eslintcache

# macOS system files
.DS_Store

# End of File